ServerSignature Off

<IfModule mod_headers.c>
    # Strip PHP version identification headers
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Ensure browsers revalidate PHP files while caching static assets
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache CSS, JavaScript, and Static Assets for 1 Month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    # Enable Gzip compression for text, css, and js
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to physical files (including favicon.ico)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 1. External redirect: /php/login or /php/login.php -> /login
    RewriteCond %{THE_REQUEST} \s/+php/login(\.php)?[\s?] [NC]
    RewriteRule ^ /login [R=301,L]

    # 2. External redirect: Strip .php from direct URL queries
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Clean Portal Routes
    RewriteRule ^login/?$ php/login.php [L,QSA]
    RewriteRule ^admin/?$ admin/dashboard.php [L,QSA]
    RewriteRule ^client/?$ client/dashboard.php [L,QSA]

    # 4. Resolve extensionless files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]

    Options -Indexes
</IfModule>