<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache CSS, JavaScript, and Static Assets for 1 Month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Ensure browsers revalidate PHP files while caching static assets
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    # Enable Gzip compression for text, css, and js
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect external requests from /php/login.php to clean /login
    RewriteCond %{THE_REQUEST} \s/+(?:php/)?login\.php[\s?] [NC]
    RewriteRule ^ /login [R=301,L]

    # Internally route /login back to /php/login.php
    RewriteRule ^login/?$ php/login.php [L,QSA]

    # Map portal shorthand routes
    RewriteRule ^admin/?$ admin/dashboard.php [L,QSA]
    RewriteRule ^client/?$ client/dashboard.php [L,QSA]

    Options -Indexes
</IfModule>